{
  "name": "nkhba-video-overlays",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "stills": "node scripts/stills.mjs",
    "storyboard": "node scripts/stills.mjs && for f in out/stills/*.png; do ffmpeg -v error -y -i $f -vf scale=1280:-1 -quality 82 storyboard/shots/$(basename ${f%.png}).webp; done && node scripts/storyboard.mjs",
    "render:audio": "remotion render Montage out/sfx-track.wav --codec=wav",
    "render:mp4": "remotion render Montage out/montage.mp4 --codec=h264",
    "render:overlay": "remotion render MontageOverlay out/montage-overlay.mov --codec=prores --prores-profile=4444 --image-format=png --pixel-format=yuva444p10le",
    "render:batch7": "remotion render Batch7 out/batch7-dub-4k.mp4 --codec=h264 --scale=2 --image-format=png --crf=14 --x264-preset=slow --pixel-format=yuv420p --audio-bitrate=320k",
    "stills:batch7": "node scripts/dub-stills.mjs"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@remotion/bundler": "^4.0.532",
    "@remotion/cli": "4.0.532",
    "@remotion/renderer": "^4.0.532",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "^5"
  }
}
